CREATE DATABASE LoteZero;
USE LoteZero;

CREATE TABLE Usuarios (
    ID INT PRIMARY KEY AUTO_INCREMENT,
    NOME VARCHAR(100) NOT NULL,
    CPF CHAR(11) NOT NULL UNIQUE,
    NASCIMENTO DATE NOT NULL,
    EMAIL VARCHAR(100) UNIQUE NOT NULL,
    TELEFONE VARCHAR(15) UNIQUE NOT NULL,
    GENERO ENUM('M', 'F', 'Nao Informar', 'Outro') NOT NULL,
    CIDADE VARCHAR(50) NOT NULL,
    ESTADO CHAR(2) NOT NULL,
    ENDERECO VARCHAR(100) NOT NULL
);

CREATE TABLE Funcionarios(
ID INT PRIMARY KEY AUTO_INCREMENT,
NOME VARCHAR(100) NOT NULL,
CPF CHAR(11) NOT NULL UNIQUE,
NASCIMENTO DATE NOT NULL,
EMAIL VARCHAR(100) UNIQUE NOT NULL,
TELEFONE VARCHAR(15) UNIQUE NOT NULL,
GENERO ENUM('M', 'F', 'Nao Informar', 'Outro') NOT NULL,
CIDADE VARCHAR(50) NOT NULL,
ESTADO CHAR(2) NOT NULL,
ENDERECO VARCHAR(100) NOT NULL,
CARGO VARCHAR(50) NOT NULL,
SALARIO DECIMAL(10,2) NOT NULL,
STATUS_FUNC ENUM('Ativo', 'Ferias','Afastado','Desligado') NOT NULL
);

CREATE TABLE Locais (
    ID INT PRIMARY KEY AUTO_INCREMENT,
    NOME VARCHAR(100) NOT NULL,
    CAPACIDADE_MAXIMA INT NOT NULL,
    ENDERECO VARCHAR(150) NOT NULL,
    CIDADE VARCHAR(50) NOT NULL,
    ESTADO CHAR(2) NOT NULL
);

CREATE TABLE Eventos (
    ID INT PRIMARY KEY AUTO_INCREMENT,
    NOME VARCHAR(100) NOT NULL,
    DATA_HORA DATETIME NOT NULL,
    CLASSIFICACAO_ETARIA INT NOT NULL,
    ID_LOCAL INT NOT NULL,
    ID_ORGANIZADOR INT NOT NULL,
    FOREIGN KEY (ID_LOCAL) REFERENCES Locais(ID),
    FOREIGN KEY (ID_ORGANIZADOR) REFERENCES Funcionarios(ID)
);

CREATE TABLE Lotes (
    ID INT PRIMARY KEY AUTO_INCREMENT,
    ID_EVENTO INT NOT NULL,
    NOME_SETOR VARCHAR(50) NOT NULL,
    VALOR DECIMAL(10,2) NOT NULL,
    QUANTIDADE_DISPONIVEL INT NOT NULL,
    FOREIGN KEY (ID_EVENTO) REFERENCES Eventos(ID)
);

CREATE TABLE Ingressos (
    ID INT PRIMARY KEY AUTO_INCREMENT,
    ID_USUARIO INT NOT NULL,
    ID_LOTE INT NOT NULL,
    DATA_COMPRA DATETIME NOT NULL,
    VALOR_PAGO DECIMAL(10,2) NOT NULL,
    STATUS_PAGAMENTO ENUM('Aprovado', 'Pendente', 'Cancelado') NOT NULL,
    FOREIGN KEY (ID_USUARIO) REFERENCES Usuarios(ID),
    FOREIGN KEY (ID_LOTE) REFERENCES Lotes(ID)
); 	


