-- AREA DE CONTAGEM
SELECT COUNT(ID) AS TOTAL_Usuarios FROM Usuarios;
SELECT SUM(VALOR_PAGO) AS FATURAMENTO_TOTAL FROM Ingressos WHERE STATUS_PAGAMENTO='Aprovado';
SELECT MAX(VALOR_PAGO)  AS INGRESSO_MAIS_CARO FROM Ingressos;
SELECT MIN(VALOR_PAGO) AS INGRESSO_MAIS_BARATO FROM Ingressos;
SELECT AVG(VALOR_PAGO) AS VALOR_MEDIO FROM Ingressos WHERE STATUS_PAGAMENTO='Aprovado';
SELECT ESTADO, COUNT(ID) AS ESTADOS_USUARIOS FROM Usuarios GROUP BY ESTADO; 
SELECT STATUS_PAGAMENTO, SUM(VALOR_PAGO) AS Valor_TOTAL FROM INGRESSOS GROUP BY STATUS_PAGAMENTO;
SELECT CARGO, AVG(SALARIO) AS MEDIA_SALARIAL FROM Funcionarios GROUP BY CARGO;
SELECT CARGO, COUNT(ID) AS FUNCIONARIOS_POR_CARGO FROM Funcionarios GROUP BY CARGO HAVING COUNT(ID) >=3;
SELECT ID_LOTE, SUM(VALOR_PAGO) AS Faturamento_Lote FROM Ingressos WHERE STATUS_PAGAMENTO='Aprovado' GROUP BY ID_LOTE HAVING SUM(VALOR_PAGO) >5000;

-- AREA UNION

SELECT NOME,EMAIL FROM Usuarios UNION ALL SELECT NOME,EMAIL FROM FUNCIONARIOS;
SELECT CIDADE FROM Usuarios UNION SELECT CIDADE FROM Funcionarios;
SELECT CIDADE FROM Usuarios EXCEPT SELECT CIDADE FROM Funcionarios;
SELECT DISTINCT ESTADO FROM Usuarios;
