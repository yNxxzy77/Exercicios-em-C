#include <stdio.h>
#include <math.h>
#include <stdlib.h>

float CalculoCartesiano(float x1,float y1,float x2, float y2){
    float distanciaH= x2 - x1;
    float distanciaV= y2 -y1;
        float distanciaHQUADRADO= distanciaH * distanciaH;
        float distanciaVQUADRADO= distanciaV * distanciaV;
            float distanciasSOMA= distanciaHQUADRADO + distanciaVQUADRADO;
                float resultado= sqrt(distanciasSOMA);
return resultado;
}

